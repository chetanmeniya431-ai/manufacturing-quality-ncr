APP_NAME="Quality NCR Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004
APP_PORT=8004

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=quality_ncr
DB_USERNAME=quality_ncr
DB_PASSWORD=secret
DB_EXTERNAL_PORT=33064

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
CSP_MODE=enforce

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ollama (local LLM + embeddings, no API keys needed) ---
# Shared Ollama instance (runs inside universal-rag-platform's stack),
# reused across every project on this machine over the nirmantra_shared
# Docker network. This app does not start its own Ollama container.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT=300

# --- RAG / chunking tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.5
TOP_K_CHUNKS=5

# --- Signals engine ---
SIGNAL_CHECK_INTERVAL_HOURS=1
EMBEDDING_BATCH_SIZE=10

VITE_APP_NAME="${APP_NAME}"
